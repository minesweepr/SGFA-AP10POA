<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <servlet>
        <servlet-name>RegistrarFalta</servlet-name>
        <servlet-class>servlets.RegistrarFaltaServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegistrarFalta</servlet-name>
        <url-pattern>/RegistrarFaltaServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DadosAluno</servlet-name>
        <servlet-class>servlets.DadosAlunoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DadosAluno</servlet-name>
        <url-pattern>/api/dados-aluno</url-pattern>
    </servlet-mapping>

    <!--Obrigando a primeira pagina ser o Login no lugar do index-->
    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>
</web-app>